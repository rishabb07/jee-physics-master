{
  "$defs": {
    "FileChecksumRecord": {
      "properties": {
        "file_path": {
          "description": "Relative path of file",
          "title": "File Path",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 fingerprint",
          "maxLength": 64,
          "minLength": 64,
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "file_path",
        "sha256",
        "size_bytes"
      ],
      "title": "FileChecksumRecord",
      "type": "object"
    }
  },
  "description": "Manifest accompanying every batch execution for complete provenance and idempotency.",
  "properties": {
    "manifest_id": {
      "description": "Unique job execution identifier",
      "minLength": 1,
      "title": "Manifest Id",
      "type": "string"
    },
    "job_type": {
      "description": "e.g. INGEST, SEGMENT, ATOMIZE, VERIFY, ASSEMBLE",
      "minLength": 1,
      "title": "Job Type",
      "type": "string"
    },
    "stage": {
      "description": "Pipeline stage where job ran",
      "title": "Stage",
      "type": "string"
    },
    "input_files": {
      "description": "Fingerprints of inputs consumed",
      "items": {
        "$ref": "#/$defs/FileChecksumRecord"
      },
      "title": "Input Files",
      "type": "array"
    },
    "output_files": {
      "description": "Fingerprints of outputs produced",
      "items": {
        "$ref": "#/$defs/FileChecksumRecord"
      },
      "title": "Output Files",
      "type": "array"
    },
    "generated_atom_ids": {
      "description": "All atom IDs emitted during this run",
      "items": {
        "type": "string"
      },
      "title": "Generated Atom Ids",
      "type": "array"
    },
    "status": {
      "default": "COMPLETED",
      "description": "QUEUED, RUNNING, COMPLETED, FAILED",
      "title": "Status",
      "type": "string"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Error trace if execution failed",
      "title": "Error Message"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "Execution parameters, model, timestamps",
      "title": "Metadata",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    }
  },
  "required": [
    "manifest_id",
    "job_type",
    "stage"
  ],
  "title": "JobManifest",
  "type": "object"
}