{
  "$defs": {
    "ContentRiskLevel": {
      "description": "Risk classification for physical content requiring calibrated verification rigor.",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "title": "ContentRiskLevel",
      "type": "string"
    },
    "VerifierOpinion": {
      "description": "An individual verifier's independent evaluation.",
      "properties": {
        "verifier_id": {
          "description": "Verifier agent identity",
          "minLength": 1,
          "title": "Verifier Id",
          "type": "string"
        },
        "verifier_conversation_id": {
          "description": "Verifier agent conversation ID",
          "minLength": 1,
          "title": "Verifier Conversation Id",
          "type": "string"
        },
        "verdict": {
          "description": "'VERIFIED' | 'REJECTED' | 'REVIEW'",
          "title": "Verdict",
          "type": "string"
        },
        "assumptions_checked": {
          "default": true,
          "description": "Whether assumptions were audited",
          "title": "Assumptions Checked",
          "type": "boolean"
        },
        "dimensional_check_passed": {
          "default": true,
          "description": "Whether dimensions were checked",
          "title": "Dimensional Check Passed",
          "type": "boolean"
        },
        "numerical_check_passed": {
          "default": true,
          "description": "Whether calculations were checked",
          "title": "Numerical Check Passed",
          "type": "boolean"
        },
        "limiting_case_check_passed": {
          "default": true,
          "description": "Whether limits were checked",
          "title": "Limiting Case Check Passed",
          "type": "boolean"
        },
        "independent_derivation_or_calculation": {
          "description": "Independent verification work",
          "minLength": 5,
          "title": "Independent Derivation Or Calculation",
          "type": "string"
        },
        "findings": {
          "description": "Verifier findings",
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "verifier_id",
        "verifier_conversation_id",
        "verdict",
        "independent_derivation_or_calculation"
      ],
      "title": "VerifierOpinion",
      "type": "object"
    }
  },
  "description": "Immutable record of dual independent verification for HIGH-risk content.",
  "properties": {
    "verification_id": {
      "description": "Unique dual verification identifier (dual-cvr-{artifact_id})",
      "minLength": 1,
      "title": "Verification Id",
      "type": "string"
    },
    "artifact_id": {
      "description": "Target content artifact ID",
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_version": {
      "default": 1,
      "description": "Artifact version",
      "minimum": 1,
      "title": "Artifact Version",
      "type": "integer"
    },
    "content_hash": {
      "description": "SHA-256 hash of verified substantive payload",
      "minLength": 8,
      "title": "Content Hash",
      "type": "string"
    },
    "risk_level": {
      "$ref": "#/$defs/ContentRiskLevel",
      "default": "HIGH",
      "description": "Risk level (strictly HIGH for dual verification)"
    },
    "verifier_a": {
      "$ref": "#/$defs/VerifierOpinion",
      "description": "First independent verifier's opinion"
    },
    "verifier_b": {
      "$ref": "#/$defs/VerifierOpinion",
      "description": "Second independent verifier's opinion"
    },
    "agreement": {
      "description": "Whether Verifier A and Verifier B agree",
      "title": "Agreement",
      "type": "boolean"
    },
    "adjudication_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Adjudication ID if discrepancy required arbitration",
      "title": "Adjudication Reference"
    },
    "final_verdict": {
      "description": "'VERIFIED' | 'REJECTED' | 'REVIEW'",
      "title": "Final Verdict",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "verification_id",
    "artifact_id",
    "content_hash",
    "verifier_a",
    "verifier_b",
    "agreement",
    "final_verdict"
  ],
  "title": "DualVerificationRecord",
  "type": "object"
}