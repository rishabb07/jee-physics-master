{
  "$defs": {
    "NormalizedAtomFingerprint": {
      "description": "Deterministic auxiliary fingerprint of an atom without mutating source truth.",
      "properties": {
        "atom_id": {
          "description": "Original atom ID",
          "minLength": 1,
          "title": "Atom Id",
          "type": "string"
        },
        "statement_normalized": {
          "description": "Cleaned, normalized statement",
          "title": "Statement Normalized",
          "type": "string"
        },
        "statement_hash": {
          "description": "SHA-256 of normalized statement",
          "minLength": 16,
          "title": "Statement Hash",
          "type": "string"
        },
        "options_normalized": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Normalized option texts if present",
          "title": "Options Normalized"
        },
        "options_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of combined normalized options",
          "title": "Options Hash"
        },
        "problem_hash": {
          "description": "SHA-256 of full problem statement + options",
          "minLength": 16,
          "title": "Problem Hash",
          "type": "string"
        },
        "taxonomy_node": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Combined chapter/topic/subtopic slug",
          "title": "Taxonomy Node"
        },
        "chapter_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Taxonomy chapter ID",
          "title": "Chapter Id"
        },
        "topic_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Taxonomy topic ID",
          "title": "Topic Id"
        },
        "subtopic_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Taxonomy subtopic ID",
          "title": "Subtopic Id"
        },
        "question_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. MCQ, NUMERICAL",
          "title": "Question Type"
        },
        "target_quantity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Physical quantity sought e.g. time_period, acceleration",
          "title": "Target Quantity"
        },
        "numerical_values": {
          "description": "Extracted numerical constants/values",
          "items": {
            "type": "string"
          },
          "title": "Numerical Values",
          "type": "array"
        },
        "has_figure": {
          "default": false,
          "description": "Whether problem requires or includes a figure",
          "title": "Has Figure",
          "type": "boolean"
        },
        "physics_skeleton_hash": {
          "description": "Abstracted structural hash of variables and target",
          "title": "Physics Skeleton Hash",
          "type": "string"
        }
      },
      "required": [
        "atom_id",
        "statement_normalized",
        "statement_hash",
        "problem_hash",
        "physics_skeleton_hash"
      ],
      "title": "NormalizedAtomFingerprint",
      "type": "object"
    }
  },
  "description": "A pair of atoms staged for deduplication comparison.",
  "properties": {
    "candidate_id": {
      "description": "Unique candidate identifier",
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "atom_a_id": {
      "description": "First atom ID",
      "minLength": 1,
      "title": "Atom A Id",
      "type": "string"
    },
    "atom_b_id": {
      "description": "Second atom ID",
      "minLength": 1,
      "title": "Atom B Id",
      "type": "string"
    },
    "generation_method": {
      "description": "e.g. EXACT_HASH_MATCH, TAXONOMY_BLOCKING, FEATURE_BLOCKING",
      "title": "Generation Method",
      "type": "string"
    },
    "blocking_signals": {
      "description": "Signals that triggered this candidate pairing",
      "items": {
        "type": "string"
      },
      "title": "Blocking Signals",
      "type": "array"
    },
    "atom_a_fingerprint": {
      "anyOf": [
        {
          "$ref": "#/$defs/NormalizedAtomFingerprint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "atom_b_fingerprint": {
      "anyOf": [
        {
          "$ref": "#/$defs/NormalizedAtomFingerprint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "comparison_features": {
      "additionalProperties": true,
      "description": "Structured physical comparison features",
      "title": "Comparison Features",
      "type": "object"
    },
    "candidate_metadata": {
      "additionalProperties": true,
      "description": "Source provenance and context",
      "title": "Candidate Metadata",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "atom_a_id",
    "atom_b_id",
    "generation_method"
  ],
  "title": "DedupCandidate",
  "type": "object"
}