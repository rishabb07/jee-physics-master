{
  "description": "Specification for generating an adaptive or milestone chapter mock test.",
  "properties": {
    "mock_id": {
      "description": "Unique mock test ID",
      "minLength": 1,
      "title": "Mock Id",
      "type": "string"
    },
    "chapter_id": {
      "description": "Chapter or multi-chapter domain slug",
      "minLength": 1,
      "title": "Chapter Id",
      "type": "string"
    },
    "title": {
      "description": "Title of the mock exam",
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "target_question_count": {
      "default": 25,
      "description": "Default JEE Physics chapter mock is 25 questions",
      "maximum": 100,
      "minimum": 5,
      "title": "Target Question Count",
      "type": "integer"
    },
    "difficulty_distribution": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Target distribution across difficulty levels L1 through L5",
      "title": "Difficulty Distribution",
      "type": "object"
    },
    "question_types": {
      "items": {
        "type": "string"
      },
      "title": "Question Types",
      "type": "array"
    },
    "time_limit_minutes": {
      "default": 60,
      "maximum": 180,
      "minimum": 15,
      "title": "Time Limit Minutes",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "mock_id",
    "chapter_id",
    "title"
  ],
  "title": "MockTestSpec",
  "type": "object"
}