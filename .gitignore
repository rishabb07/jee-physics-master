# Virtual environment
.venv/
venv/
ENV/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Build and staging artifacts
build/drafts/*
!build/drafts/.gitkeep
build/staging/atoms/*
!build/staging/atoms/.gitkeep
build/staging/manifests/*
!build/staging/manifests/.gitkeep
build/reports/*
!build/reports/.gitkeep

# Output artifacts (disposable projections)
output/book/*
!output/book/.gitkeep
output/question_bank/*
!output/question_bank/.gitkeep
output/question_ladders/*
!output/question_ladders/.gitkeep
output/mock_tests/*
!output/mock_tests/.gitkeep
output/web/*
!output/web/.gitkeep
build/web/*
!build/web/.gitkeep

# Reference textbooks and raw PDFs (>100MB)
*.pdf

# Temporary files & locks
*.tmp
*.lock
.DS_Store
Thumbs.db
dump.json
dump_formulas.py
gen_verification.py
run_qa.py
scratch_assemble.py
