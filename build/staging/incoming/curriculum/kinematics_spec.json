  "worked_example_sequence": [
    {
      "example_id": "ex-kin-calc-motion-01",
      "problem_statement": "A particle moves such that its position is x = 2t^3 - 3t^2. Find its acceleration when velocity is zero.",
      "known_quantities": {
        "x(t)": "2t^3 - 3t^2"
      },
      "target_quantity": "a at v=0",
      "relevant_concepts": [
        "concept-kin-accel-01"
      ],
      "governing_principles": [
        "v = dx/dt",
        "a = dv/dt"
      ],
      "solution_strategy": "Differentiate x to find v, solve v=0 for t. Differentiate v to find a, substitute t.",
      "step_by_step_derivation": [
        "v = 6t^2 - 6t",
        "6t^2 - 6t = 0 => t = 0, 1",
        "a = 12t - 6",
        "At t=0, a=-6. At t=1, a=6"
      ],
      "final_answer": "a = -6 m/s^2 or 6 m/s^2",
      "sanity_checks": [
        "Dimensional analysis of derivatives"
      ],
      "alternate_methods": [],
      "source_atom_id": "atom-kin-ex-01",
      "provenance": [],
      "verification_status": "VERIFIED"
    },
    {
      "example_id": "ex-kin-gravity-balloon-01",
      "problem_statement": "A stone is dropped from a balloon ascending with constant velocity. Find time to reach ground.",
      "known_quantities": {
        "v_balloon": "v_0 upwards",
        "h": "height"
      },
      "target_quantity": "time t",
      "relevant_concepts": [
        "concept-kin-gravity-01"
      ],
      "governing_principles": [
        "s = ut + 0.5at^2"
      ],
      "solution_strategy": "Use relative frame or ground frame with u = v_0 upwards, s = -h, a = -g.",
      "step_by_step_derivation": [
        "-h = v_0 t - 0.5 g t^2",
        "0.5 g t^2 - v_0 t - h = 0",
        "Solve quadratic for t"
      ],
      "final_answer": "t = (v_0 + sqrt(v_0^2 + 2gh))/g",
      "sanity_checks": [
        "If v_0 = 0, t = sqrt(2h/g)"
      ],
      "alternate_methods": [],
      "source_atom_id": "atom-kin-ex-02",
      "provenance": [],
      "verification_status": "VERIFIED"
    },
    {
      "example_id": "ex-kin-projectile-max-height",
      "problem_statement": "Find angle of projection for which horizontal range and maximum height are equal.",
      "known_quantities": {
        "R": "H"
      },
      "target_quantity": "theta",
      "relevant_concepts": [
        "concept-kin-projectile-01"
      ],
      "governing_principles": [
        "R formula",
        "H formula"
      ],
      "solution_strategy": "Equate R and H expressions, simplify to find tan(theta).",
      "step_by_step_derivation": [
        "u^2 sin2theta/g = u^2 sin^2theta / (2g)",
        "2 sin(theta)cos(theta) = sin^2(theta)/2",
        "tan(theta) = 4"
      ],
      "final_answer": "theta = arctan(4)",
      "sanity_checks": [
        "Units cancel out"
      ],
      "alternate_methods": [],
      "source_atom_id": "atom-kin-ex-03",
      "provenance": [],
      "verification_status": "VERIFIED"
    },
    {
