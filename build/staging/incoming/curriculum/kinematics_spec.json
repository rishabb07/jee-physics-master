  "misconception_sequence": [
    {
      "misconception_id": "misc-kin-01",
      "category": "VECTOR_SCALAR_CONFUSION",
      "statement": "Distance and displacement are always equal in magnitude.",
      "explanation": "Distance is path length, displacement is shortest distance between initial and final points. They are only equal for unidirectional straight line motion.",
      "trap_mechanism": "Questions reversing direction",
      "trigger_conditions": [
        "Particle turns back"
      ],
      "connected_concept_ids": [
        "concept-kin-pos-disp-01"
      ],
      "connected_atom_ids": []
    },
    {
      "misconception_id": "misc-kin-02",
      "category": "SIGN_MISTAKE",
      "statement": "Acceleration is always negative when an object is slowing down.",
      "explanation": "Deceleration means velocity and acceleration have opposite signs. If v is negative, a must be positive to slow down.",
      "trap_mechanism": "Negative initial velocity",
      "trigger_conditions": [
