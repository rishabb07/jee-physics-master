    "\\omega": "Final angular velocity",
    "\\omega_0": "Initial angular velocity",
    "\\alpha": "Constant angular acceleration",
    "\\theta": "Net angular displacement",
    "t": "Elapsed time"
  },
  "units": {
    "\\omega": "rad/s",
