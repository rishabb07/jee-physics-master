  "question": {
    "statement": "An insect crawls up a hemispherical surface very slowly. The coefficient of friction between the insect and the surface is $\\frac{1}{3}$. If the line joining the centre of the hemispherical surface to the insect makes an angle $\\alpha$ with the vertical, the maximum possible value of $\\alpha$ so that the insect does not slip is given by",
    "options": [
      {
        "id": "A",
        "text": "$\\cot \\alpha = 3$"
      },
      {
        "id": "B",
        "text": "$\\sec \\alpha = 3$"
      },
      {
        "id": "C",
        "text": "$\\operatorname{cosec} \\alpha = 3$"
      },
      {
        "id": "D",
        "text": "$\\cos \\alpha = 3$"
      }
    ],
    "source_claimed_answer": "A",
    "verified_answer": "A",
    "source_solution": null,
    "answer": "A",
